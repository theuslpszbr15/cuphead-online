<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Cuphead Online</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net40</TargetFramework>
    <LangVersion>11.0</LangVersion>
    <RootNamespace />
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>
  <!-- The modded Assembly-CSharp.dll is built locally from your own copy of the game and never committed. -->
  <ItemGroup Condition="Exists('..\dist\Assembly-CSharp.dll')">
    <EmbeddedResource Include="..\dist\Assembly-CSharp.dll" LogicalName="Assembly-CSharp.dll" />
  </ItemGroup>
</Project>
